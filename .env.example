# Bot Tia Nane — variáveis de ambiente (copie para .env; nunca coloque segredos reais aqui)

# --- Banco ---------------------------------------------------------------
# Local: cluster próprio criado por `npm run db:start` (porta 54400, auth trust só em localhost).
DATABASE_URL=postgres://postgres@localhost:54400/tia_nane
TEST_DATABASE_URL=postgres://postgres@localhost:54400/tia_nane_test
# Pasta dos binários do PostgreSQL (initdb, pg_ctl, psql) se não estiverem no PATH.
PG_BIN=
LOCAL_PG_PORT=54400

# --- Operação ------------------------------------------------------------
# true = nada é enviado a provedores reais; mensagens ficam marcadas como simuladas.
SIMULATION_MODE=true
# Configuração aprovada do negócio (serviços, preços, horários). O arquivo demo é recusado fora da simulação.
BUSINESS_CONFIG_PATH=config/negocio.demo.json
# Fuso usado para regras de expediente. O banco grava tudo em UTC (timestamptz).
TIMEZONE=America/Sao_Paulo
# Acompanhamentos D+1/D+3/D+7: desligados até a etapa 4 e até haver consentimento e finalidade elegível.
FOLLOWUPS_ENABLED=false
LOG_LEVEL=info

# Porta do servidor do webhook (npm start).
PORT=3000

# --- Agente de IA (Anthropic) ----------------------------------------------
# Com a chave preenchida, a IA responde o texto livre dos clientes; sem ela, só o menu automático.
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5-5. Alternativas mais baratas: claude-sonnet-5-5, claude-haiku-5-5.
ANTHROPIC_MODEL=
# Esforço de raciocínio por resposta: low (rápido, padrão para conversa), medium ou high.
AI_EFFORT=low
# false desliga a IA mesmo com chave (volta a responder só pelo menu).
AGENT_ENABLED=true

# --- WhatsApp Cloud API (obrigatórias quando SIMULATION_MODE=false) ------------
# Segredo do aplicativo Meta: valida a assinatura X-Hub-Signature-256 dos POSTs.
META_APP_SECRET=
# Token escolhido por você para a verificação GET do webhook (não substitui o segredo do app).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Versão da Graph API (v26.0 em 28/10/2026) — confirme a vigente na documentação da Meta.
GRAPH_API_VERSION=
PUBLIC_BASE_URL=
